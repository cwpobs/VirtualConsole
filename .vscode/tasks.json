{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "MSBuild: VirtualConsole (Debug|x64)",
            "type": "shell",
            "command": "C:\\Program Files\\Microsoft Visual Studio\\18\\Insiders\\MSBuild\\Current\\Bin\\MSBuild.exe",
            "args": [
                "${workspaceFolder}\\VirtualConsole.slnx",
                "/p:Configuration=Debug",
                "/p:Platform=x64",
                "/m",
                "/nologo"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
